<?xml version="1.0" encoding="UTF-8"?>
<project version="1">
    <builddir>Care-cppcheck-build-dir</builddir>
    <importproject>Care.exe/Care.sln</importproject>
    <analyze-all-vs-configs>false</analyze-all-vs-configs>
    <check-headers>true</check-headers>
    <check-unused-templates>false</check-unused-templates>
    <inline-suppression>true</inline-suppression>
    <max-ctu-depth>2</max-ctu-depth>
    <max-template-recursion>100</max-template-recursion>
    <user-include>Care.exe/Src/main.h</user-include>
    <vs-configurations>
        <config>Debug</config>
        <config>Demo</config>
        <config>Release</config>
    </vs-configurations>
    <check-level-reduced/>
    <project-name>Care</project-name>
</project>
